# Required in production: base URL of the web app (ctc-wapp). Log in goes to $NEXT_PUBLIC_APP_URL/login.
NEXT_PUBLIC_APP_URL=https://app.crackthecampus.com
# Canonical site URL used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://crackthecampus.com
# Optional: social links appear in the footer only when set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Web3Forms access key: contact, demo and newsletter forms email the inbox tied to this key
NEXT_PUBLIC_WEB3FORMS_KEY=
